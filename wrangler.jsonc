{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "mudakir",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}